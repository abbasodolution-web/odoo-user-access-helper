<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_access_wizard_view_form" model="ir.ui.view">
        <field name="name">user.access.wizard.form</field>
        <field name="model">user.access.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <group>
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
                <group invisible="mode != 'password'">
                    <field name="new_password" password="True" required="mode == 'password'"/>
                    <field name="confirm_password" password="True" required="mode == 'password'"/>
                </group>
                <div invisible="mode != 'totp'" class="alert alert-info" role="alert">
                    <field name="totp_user_count" class="oe_inline"/> of the selected users have
                    two-factor authentication enabled. It will be turned off and their trusted
                    devices revoked, so they can log in with their password and set it up again.
                </div>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_user_access_reset_password" model="ir.actions.act_window">
        <field name="name">Reset Password</field>
        <field name="res_model">user.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'password'}</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_user_access_disable_totp" model="ir.actions.act_window">
        <field name="name">Disable 2FA</field>
        <field name="res_model">user.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'totp'}</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
