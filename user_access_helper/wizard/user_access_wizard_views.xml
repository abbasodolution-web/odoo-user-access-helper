<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_access_wizard_view_form" model="ir.ui.view">
        <field name="name">user.access.wizard.form</field>
        <field name="model">user.access.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="mode" widget="radio"/>
                </group>
                <group invisible="mode != 'password' or generated_password">
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                    <div colspan="2">
                        <button name="action_generate_password" type="object" class="btn-link ps-0"
                                icon="fa-magic" string="Generate a strong password"/>
                    </div>
                </group>
                <group invisible="mode != 'password' or not generated_password">
                    <field name="generated_password" string="New password" widget="CopyClipboardChar"/>
                    <div colspan="2" class="text-muted">
                        Copy it now: it is not shown again or stored anywhere after you apply.
                    </div>
                </group>
                <div class="alert alert-info" role="alert" invisible="not summary">
                    <field name="summary" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="mode != 'deactivate'">
                    Deactivated users cannot log in. Nothing they created is deleted.
                </div>
                <group>
                    <field name="reason" placeholder="e.g. Ticket #1234, left the company, lost phone"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_user_access_wizard" model="ir.actions.act_window">
        <field name="name">Access Actions</field>
        <field name="res_model">user.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_user_access_wizard_overview" model="ir.actions.act_window">
        <field name="name">Access Actions</field>
        <field name="res_model">user.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_user_access_overview"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
