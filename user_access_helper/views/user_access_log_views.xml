<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_access_log_view_list" model="ir.ui.view">
        <field name="name">user.access.log.list</field>
        <field name="model">user.access.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="action" widget="badge"
                       decoration-danger="action in ('deactivate', 'apikeys') or admin_granted"
                       decoration-warning="action in ('totp', 'logout')"
                       decoration-info="action in ('password', 'reset_email', 'groups') and not admin_granted"
                       decoration-success="action == 'reactivate'"/>
                <field name="details"/>
                <field name="reason" optional="show"/>
                <field name="done_by_id"/>
                <field name="ip_address" optional="hide"/>
                <field name="admin_granted" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="user_access_log_view_form" model="ir.ui.view">
        <field name="name">user.access.log.form</field>
        <field name="model">user.access.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="admin_granted" invisible="not admin_granted"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="done_by_id"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <field name="details"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="user_access_log_view_search" model="ir.ui.view">
        <field name="name">user.access.log.search</field>
        <field name="model">user.access.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="done_by_id"/>
                <field name="details"/>
                <field name="reason"/>
                <filter string="Admin rights granted" name="admin_granted" domain="[('admin_granted', '=', True)]"/>
                <filter string="Access rights changes" name="groups" domain="[('action', '=', 'groups')]"/>
                <filter string="Passwords" name="password" domain="[('action', 'in', ('password', 'reset_email'))]"/>
                <filter string="2FA disabled" name="totp" domain="[('action', '=', 'totp')]"/>
                <filter string="Offboarding" name="offboarding"
                        domain="[('action', 'in', ('deactivate', 'logout', 'apikeys'))]"/>
                <separator/>
                <filter string="Last 7 days" name="last_week"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="date" date="create_date"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}"/>
                    <filter string="Done By" name="group_done_by" context="{'group_by': 'done_by_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_user_access_log" model="ir.actions.act_window">
        <field name="name">User Access Log</field>
        <field name="res_model">user.access.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No access changes yet</p>
            <p>Password resets, 2FA and session changes, deactivations and access rights changes appear here.</p>
        </field>
    </record>
</odoo>
